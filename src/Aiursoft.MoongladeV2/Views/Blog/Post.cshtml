@using Aiursoft.WebTools
@using Aiursoft.MoongladeV2.Controllers
@using System.Globalization
@model Aiursoft.MoongladeV2.Models.BlogViewModels.PostViewModel
@inject Aiursoft.MoongladeV2.Services.FileStorage.StorageService Storage
@inject Aiursoft.MoongladeV2.Services.MoongladeV2Service CommentMarkdown

@{
    var isDarkMode = Context.Request.Cookies[ThemeController.ThemeCookieKey] == true.ToString();
    var showAuthorInfo = ViewBag.ShowAuthorInfo as bool? ?? true;
}

<vc:marketing-navbar></vc:marketing-navbar>

<main class="moonglade-blog-shell body-post-slug @(isDarkMode ? "darkmode" : null)">
    <div class="container post-page-container py-4 py-lg-5">
        <div class="post-layout">
            <div class="post-main-column">
                <article class="article-post-slug box border position-relative mb-4" data-postid="@Model.DocumentId" lang="@CultureInfo.CurrentCulture.TwoLetterISOLanguageName">
            <header class="post-header text-center">
                <a class="post-back-link" asp-controller="Blog" asp-action="Index">@Localizer["Back to posts"]</a>
                <h1 class="post-title font-sairas">@Model.Title</h1>

                @if (showAuthorInfo)
                {
                    <div class="post-author-info d-flex align-items-center justify-content-center gap-3 mb-3">
                        <img src="@Storage.RelativePathToInternetUrl(Model.AuthorAvatarPath)?w=64&square=true"
                             alt="@Model.AuthorName" class="rounded-circle" width="48" height="48"
                             style="object-fit: cover;" />
                        <div class="text-start">
                            <div class="fw-bold">@Model.AuthorName</div>
                            <div class="text-muted small">
                                <time datetime="@Model.PublishedAt.ToString("O", CultureInfo.InvariantCulture)">
                                    @Model.PublishedAt.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)
                                </time>
                                <span class="ms-2">· @Localizer["Views"] @Model.ViewCount.ToString("N0", CultureInfo.CurrentCulture)</span>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="post-publish-info text-muted mb-2">
                        <span class="me-2">
                            <span class="post-meta-label">@Localizer["Published"]</span>
                            <time datetime="@Model.PublishedAt.ToString("O", CultureInfo.InvariantCulture)">
                                @Model.PublishedAt.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)
                            </time>
                            <span class="ms-2">· @Localizer["Views"] @Model.ViewCount.ToString("N0", CultureInfo.CurrentCulture)</span>
                        </span>
                    </div>
                }

                @if (Model.Tags.Any())
                {
                    <div class="post-summary-tags mt-3">
                        @foreach (var tag in Model.Tags)
                        {
                            <a class="d-inline-block me-1 mb-1 btn btn-sm btn-accent" asp-controller="Blog" asp-action="Tag" asp-route-tag="@tag">@tag</a>
                        }
                    </div>
                }

                <hr class="d-none d-md-block" />
            </header>

            @if (!string.IsNullOrWhiteSpace(Model.HeroImageUrl))
            {
                <div class="post-hero-image-container text-center mb-3">
                    <img src="@Model.HeroImageUrl" alt="@Model.Title" class="post-hero-image img-fluid rounded-3 shadow-sm" loading="lazy" />
                </div>
            }

            <section class="post-content markdown-content clearfix">
                @Html.Raw(Model.ContentHtml)
            </section>
                </article>

                <section id="comments" class="box comment-form-containter mb-4">
            <h5 class="mb-3">@Localizer["Comments"] (@Model.CommentCount)</h5>

            @if (Model.EnableComments && (User.Identity?.IsAuthenticated == true || Model.AllowAnonymousComments))
            {
            <form asp-controller="Comments" asp-action="Post" method="post" class="mb-4" id="comment-form">
                    <input type="hidden" name="documentId" value="@Model.DocumentId" />
                    <input type="hidden" name="parentCommentId" id="parent-comment-id" />
                    <input type="hidden" name="captchaToken" id="comment-captcha-token" value="@Model.CaptchaToken" />
                    @Html.AntiForgeryToken()
                    @if (User.Identity?.IsAuthenticated != true)
                    {
                        <div class="row g-2 mb-2">
                            <div class="col-sm-6">
                                <input name="guestName" class="form-control" maxlength="64" placeholder="@Localizer["Your name"]" aria-label="@Localizer["Your name"]" required />
                            </div>
                            <div class="col-sm-6">
                                <input name="guestEmail" type="email" class="form-control" maxlength="254" placeholder="@Localizer["Email (optional)"]" aria-label="@Localizer["Email (optional)"]" />
                            </div>
                        </div>
                        <p class="small text-muted mb-2">@Localizer["Your email will not be displayed publicly."]</p>
                    }
                    <div class="mb-2">
                        <textarea name="content" class="form-control" rows="4" placeholder="@Localizer["Write your comment... (Markdown supported)"]" aria-label="@Localizer["Write your comment... (Markdown supported)"]" maxlength="65535" required></textarea>
                    </div>
                    <div class="d-flex flex-wrap align-items-end justify-content-between gap-2">
                        <div>
                            <label for="comment-captcha-answer" class="small mb-1">@Localizer["Verification"]</label>
                            <div class="input-group input-group-sm">
                                <img id="comment-captcha-image" src="data:image/png;base64,@Model.CaptchaImageBase64" alt="@Localizer["Verification"]" class="border rounded-start" width="100" height="36" />
                                <button type="button" id="refresh-comment-captcha" class="btn btn-outline-secondary" title="@Localizer["Refresh verification code"]" aria-label="@Localizer["Refresh verification code"]">↻</button>
                                <input name="captchaAnswer" id="comment-captcha-answer" type="text" class="form-control" style="max-width: 9rem" maxlength="4" minlength="4" required autocomplete="off" inputmode="text" />
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <button type="button" id="cancel-comment-reply" class="btn btn-outline-secondary btn-sm d-none">@Localizer["Cancel reply"]</button>
                            <button type="submit" class="btn btn-accent btn-sm">@Localizer["Post Comment"]</button>
                            @if (User.Identity?.IsAuthenticated != true)
                            {
                                <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString + "#comments")" class="btn btn-outline-secondary btn-sm">@Localizer["Login"]</a>
                            }
                        </div>
                    </div>
            </form>
            }
            else if (Model.EnableComments)
            {
                <p class="text-muted mb-4">@Localizer["Sign in to comment."]
                    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString + "#comments")" class="btn btn-accent btn-sm ms-2">@Localizer["Login"]</a>
                </p>
            }

            @if (Model.CommentCount == 0)
            {
                <p class="text-muted text-center py-3">@Localizer["No comments yet. Be the first to leave one!"]</p>
            }

            <div class="comment-list">
                @foreach (var comment in Model.Comments)
                {
                    <div class="comment-item mb-3" id="comment-@comment.Id">
                        <div class="d-flex gap-3">
                            <div class="flex-shrink-0">
                                <div class="comment-avatar">
                                    @(comment.AuthorDisplayName.Length > 0 ? comment.AuthorDisplayName[0].ToString().ToUpper(CultureInfo.CurrentCulture) : "?")
                                </div>
                            </div>
                            <div class="flex-grow-1">
                                <div class="comment-bubble">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <div>
                                            <strong class="me-2">@comment.AuthorDisplayName</strong>
                                            @if (comment.UserId == null)
                                            {
                                                <span class="badge bg-secondary me-2">@Localizer["Guest"]</span>
                                            }
                                            <small class="text-muted"><label data-utc-time="@comment.CreatedAt.ToHtmlDateTime()"></label></small>
                                        </div>
                                        @if (User.Identity?.IsAuthenticated == true &&
                                             User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value == comment.UserId)
                                        {
                                            <form asp-controller="Comments" asp-action="Delete" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="commentId" value="@comment.Id" />
                                                <button type="submit" class="btn btn-link btn-sm text-danger p-0" onclick="return confirm('@Localizer["Are you sure you want to delete this comment?"]')">@Localizer["Delete"]</button>
                                            </form>
                                        }
                                    </div>
                                    <div class="markdown-content mb-2">@Html.Raw(CommentMarkdown.ConvertMarkdownToHtml(comment.Content))</div>

                                    @if (comment.Replies.Any())
                                    {
                                        <div class="comment-replies">
                                            @foreach (var reply in comment.Replies.OrderBy(r => r.CreatedAt))
                                            {
                                                <div class="d-flex gap-2 mb-2 pt-2" id="comment-@reply.Id">
                                                    <div class="flex-shrink-0">
                                                        <div class="comment-avatar comment-avatar-sm">
                                                            @(reply.AuthorDisplayName.Length > 0 ? reply.AuthorDisplayName[0].ToString().ToUpper(CultureInfo.CurrentCulture) : "?")
                                                        </div>
                                                    </div>
                                                    <div class="flex-grow-1">
                                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                                            <div>
                                                                <strong class="me-2">@reply.AuthorDisplayName</strong>
                                                                @if (reply.UserId == null)
                                                                {
                                                                    <span class="badge bg-secondary me-2">@Localizer["Guest"]</span>
                                                                }
                                                                <small class="text-muted"><label data-utc-time="@reply.CreatedAt.ToHtmlDateTime()"></label></small>
                                                            </div>
                                                            @if (User.Identity?.IsAuthenticated == true &&
                                                                 User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value == reply.UserId)
                                                            {
                                                                <form asp-controller="Comments" asp-action="Delete" method="post" class="d-inline">
                                                                    @Html.AntiForgeryToken()
                                                                    <input type="hidden" name="commentId" value="@reply.Id" />
                                                                    <button type="submit" class="btn btn-link btn-sm text-danger p-0" onclick="return confirm('@Localizer["Are you sure you want to delete this reply?"]')">@Localizer["Delete"]</button>
                                                                </form>
                                                            }
                                                        </div>
                                                        <div class="markdown-content mb-0">@Html.Raw(CommentMarkdown.ConvertMarkdownToHtml(reply.Content))</div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }

                                    @if (Model.EnableComments && (User.Identity?.IsAuthenticated == true || Model.AllowAnonymousComments))
                                    {
                                        <div class="mt-2">
                                            <button type="button" class="btn btn-link btn-sm p-0 text-secondary toggle-reply" data-comment-id="@comment.Id">@Localizer["Reply"]</button>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

                </section>
            </div>

            <aside class="post-outline" data-document-outline aria-label="@Localizer["On this page"]" hidden>
                <div class="post-outline-title">@Localizer["On this page"]</div>
                <nav aria-label="@Localizer["Document outline"]">
                    <ol class="post-outline-list"></ol>
                </nav>
            </aside>
        </div>
    </div>
</main>

<vc:marketing-footer></vc:marketing-footer>

@* ReSharper disable once Razor.SectionNotResolved *@
@section scripts {
    <script>
        document.getElementById("refresh-comment-captcha")?.addEventListener("click", async function () {
            const button = this;
            button.disabled = true;
            try {
                const response = await fetch('@Url.Action("Captcha", "Comments")?documentId=@Model.DocumentId', { cache: 'no-store' });
                if (!response.ok) throw new Error('Captcha refresh failed');
                const captcha = await response.json();
                document.getElementById("comment-captcha-token").value = captcha.token;
                document.getElementById("comment-captcha-image").src = `data:image/png;base64,${captcha.imageBase64}`;
                document.getElementById("comment-captcha-answer").value = '';
            } catch (error) {
                console.error(error);
            } finally {
                button.disabled = false;
            }
        });
    </script>
    <script>
        window.MathJax = {
            tex: {
                inlineMath: [['$', '$'], ['\\(', '\\)']],
                displayMath: [['$$', '$$'], ['\\[', '\\]']],
            },
            svg: {
                fontCache: 'global'
            }
        };
    </script>
    <script id="MathJax-script" defer src="~/node_modules/mathjax/es5/tex-mml-chtml.js" asp-append-version="true"></script>
    <script src="~/node_modules/mermaid/dist/mermaid.min.js" asp-append-version="true"></script>
    <script src="~/node_modules/@@highlightjs/cdn-assets/highlight.min.js" asp-append-version="true"></script>
    <script src="~/node_modules/@@aiursoft/uistack-markdown-ui/dist/index.global.js" asp-append-version="true"></script>
    <script src="~/scripts/document-outline.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AiursoftMarkdownUi.initializeMarkdownReader({
                container: '.post-content',
                mermaidTheme: '@(isDarkMode ? "dark" : "default")'
            }).catch(function () {});
        });
    </script>
    <script>
        document.querySelectorAll(".toggle-reply").forEach(function (button) {
            button.addEventListener("click", function () {
                document.getElementById("parent-comment-id").value = this.dataset.commentId;
                document.getElementById("cancel-comment-reply").classList.remove("d-none");
                document.getElementById("comment-form").scrollIntoView({ behavior: "smooth", block: "center" });
                document.querySelector("#comment-form textarea[name='content']").focus({ preventScroll: true });
            });
        });
        document.getElementById("cancel-comment-reply")?.addEventListener("click", function () {
            document.getElementById("parent-comment-id").value = "";
            this.classList.add("d-none");
        });
    </script>
}

@* ReSharper disable once Razor.SectionNotResolved *@
@section styles {
    <link rel="canonical" href="@ViewBag.CanonicalUrl" />
    <meta property="og:url" content="@ViewBag.CanonicalUrl" />
    <link rel="stylesheet" href="~/node_modules/@@fontsource/cascadia-code/index.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/styles/markdown-reader.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/styles/blog.css" asp-append-version="true" />
    @if (isDarkMode)
    {
        <link rel="stylesheet" href="~/node_modules/@@highlightjs/cdn-assets/styles/github-dark.min.css" asp-append-version="true" />
    }
    else
    {
        <link rel="stylesheet" href="~/node_modules/@@highlightjs/cdn-assets/styles/github.min.css" asp-append-version="true" />
    }
}
